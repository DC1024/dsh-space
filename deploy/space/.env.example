# Copy to .env and fill in. Never commit the real .env.
DEEPSEEK_API_KEY=sk-replace-me
# OpenAI-compatible model gateway used by the DSH runtime.
DSH_MODEL_BASE_URL=http://127.0.0.1:3425/v1
# Must match the gateway's X-DSH-Proxy-Authorized value.
DSH_PROXY_SECRET=replace-with-a-random-token
SPACE_HOST=192.168.1.10
DESKTOP_HOST=192.168.1.20
